{
  "schema_version": 2,
  "project_id": "6d169e87-c824-4870-9b6e-7797fbf86ef8",
  "title": "Ideas browser-local workspace",
  "storage_owner": "current-device browser",
  "builtin_models": [],
  "default_space": "empty user-created space",
  "modules": [
    {
      "id": "frontend",
      "path": "web",
      "role": "space lifecycle, local atomic storage, direct user model transport, settings, local graph and transfer"
    },
    {
      "id": "backend",
      "path": "yang",
      "role": "legacy CLI/backend retained for explicit migration and regression; unused by current web app"
    },
    {
      "id": "qa",
      "path": "tests",
      "role": "legacy backend regressions plus local browser and direct-model contracts"
    },
    {
      "id": "ops",
      "path": ".",
      "role": "single-file build and static hosting configuration"
    }
  ],
  "nodes": [
    {
      "id": "space",
      "source": "web/src/09_boot.js"
    },
    {
      "id": "local-store",
      "source": "web/src/02_db.js"
    },
    {
      "id": "model-transport",
      "source": "web/src/03_api.js"
    },
    {
      "id": "model-actions",
      "source": "web/src/04_agent.js"
    },
    {
      "id": "settings",
      "source": "web/src/07_data.js"
    },
    {
      "id": "graph",
      "source": "web/src/local_graph.js"
    },
    {
      "id": "transfer",
      "source": "web/src/yangdata.js"
    },
    {
      "id": "static-host",
      "source": "deploy/ides.service"
    }
  ],
  "edges": [
    {
      "source": "static-host",
      "target": "space",
      "action": "distribute static page"
    },
    {
      "source": "space",
      "target": "local-store",
      "action": "open independent space"
    },
    {
      "source": "settings",
      "target": "local-store",
      "action": "explicit configuration save"
    },
    {
      "source": "model-actions",
      "target": "model-transport",
      "action": "user-initiated direct provider request"
    },
    {
      "source": "model-actions",
      "target": "local-store",
      "action": "persist user-approved answers"
    },
    {
      "source": "settings",
      "target": "transfer",
      "action": "validate import / export JSONL"
    },
    {
      "source": "graph",
      "target": "local-store",
      "action": "read local documents only"
    }
  ],
  "data_stores": [
    {
      "id": "space-index",
      "engine": "localStorage",
      "key": "yang.spaces.v3"
    },
    {
      "id": "space-records",
      "engine": "IndexedDB",
      "key": "yang.space.v3.<id>",
      "contains": [
        "space",
        "ideas",
        "sparks",
        "cold",
        "model configuration and keys",
        "revision"
      ]
    },
    {
      "id": "unsaved-draft",
      "engine": "sessionStorage",
      "key": "yang.draft.<id>"
    }
  ],
  "flows": {
    "onboarding": [
      "create empty personal space",
      "configure user-owned model",
      "optional explicit connection test",
      "save model locally",
      "build ideas",
      "export backup or import validated data"
    ],
    "persistence": [
      "capture local state",
      "skip navigation-only changes",
      "queue during in-flight write",
      "check IndexedDB revision in readwrite transaction",
      "commit or preserve draft with conflict prompt"
    ],
    "model": [
      "select user default or action model",
      "validate URL and model ID",
      "send direct CORS request without cookies",
      "parse JSON or SSE",
      "show cancellation/errors without built-in fallback"
    ]
  },
  "privacy": {
    "application_api_calls": false,
    "data_persisted_on_application_server": false,
    "model_requests": "relevant content sent only to user-configured provider on explicit operation",
    "plain_export_keys": false,
    "encrypted_export_keys": true,
    "legacy_data": "retained; import is explicit"
  }
}
