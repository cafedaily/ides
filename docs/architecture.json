  "flows": {
    "sync": [
      "capture acknowledged base",
      "diff current records",
      "POST base_revision/upsert/delete",
      "BEGIN IMMEDIATE",
      "validate revision and complete state",
      "commit or 409 without writes",
      "queue edits received during request"
    ],
    "graph": [
      "collect source documents",
      "normalize aliases",
      "update changed n-gram statistics",
      "select entities",
      "retokenize affected documents",
      "rescore exact global IDF",
      "reuse pair topology and update weights",
      "preserve original evidence"
    ],
    "privacy": [
      "public health is redacted",
      "session check before private state",
      "demo data never automatically merges into owner data",
      "logout clears rendered private views",
      "unsynced draft remains in private namespace"
    ]
  }
