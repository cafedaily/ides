      "knowledge": {
        "schema_version": 2,
        "module": "backend",
        "truths": [
          {
            "statement": "/api/chat backend model selection reads conf.models and optional conf.route[action]."
          },
          {
            "statement": "When body.action maps to a configured model id, yang/chat.py sends the OpenAI-compatible request to that model's base URL and model name."
          },
          {
            "statement": "Missing action, missing route, empty route value, or an unrouted action remains compatible by selecting the first configured model."
          },
          {
            "statement": "If conf.route[action] names a model id not present in conf.models, complete returns ok:false with an error naming the action and missing id before any outbound request."
          }
        ],
        "dont_assume": [
          "Model API keys must not be printed or exposed to the frontend.",
          "Configured model routes are validated at request time, not during data-entry rendering."
        ]
      },
      "source": ".structure/modules/10e08a419e850eba1ebba18fdd28eb7ec1b7e8baa9bcc3b973e2b8891ec726be.json"
    },
